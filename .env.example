# Copy to .env and fill in real values. .env is gitignored.

# --- Secrets ---
# GitHub personal access token - used by the GitHub MCP server
GITHUB_TOKEN=ghp_xxx

# Vercel API token - used to read deployment logs and trigger redeploys
VERCEL_TOKEN=xxx

# Google Gemini API key - used by every LlmAgent
GOOGLE_API_KEY=xxx

# Model tiers (optional). FAST_MODEL = mechanical agents (repo/file reading);
# SMART_MODEL = reasoning agents (log analysis, fix, validation, fix-apply).
# FAST_MODEL=gemini-2.5-flash
# SMART_MODEL=gemini-2.5-pro

# --- Project config (stable per repo) ---
# Repo that owns the deployment (the pipeline opens a PR against this repo)
GITHUB_OWNER=your-username-or-org
GITHUB_REPO=your-repo-name
# Branch to base the fix PR on (optional, defaults to "main")
BASE_BRANCH=main

# Force the human-approval [y/N] gate for EVERY fix, even low-risk ones.
# Handy for live demos so the approval step always shows. Default: false.
# REQUIRE_APPROVAL=true

# Vercel project name, used to AUTO-DISCOVER the latest failed deployment.
# Defaults to GITHUB_REPO if omitted. Set this if your Vercel project name
# differs from the repo name.
# VERCEL_PROJECT=deploymind-test-app

# The failed deployment ID changes every run, so it is NOT required.
# Resolution order: CLI arg  ->  DEPLOYMENT_ID below  ->  auto-discovery  ->  prompt.
#   python agent.py dpl_xxx        # explicit
#   python agent.py                # auto-finds the latest FAILED deployment
# DEPLOYMENT_ID=dpl_xxx
